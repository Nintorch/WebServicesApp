@model List<CategoryViewModel>
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-left">
    <h1 class="display-4">Сайт с новостями</h1>

    <a href="/Home/Index" class="btn btn-primary">Вернуться к списку новостей</a>
    <a href="/Category/Parameters" class="btn btn-primary">Создать категорию</a>
    <br />

    <button class="btn btn-primary" type="button" data-toggle="collapse" data-target="#variantSearch" aria-expanded="false" aria-controls="variantSearch">
        Поиск категорий
    </button><br />
    <div class="collapse" id="variantSearch">
        <div class="card card-body">
            <form method="post">
                <label for="name" class="form-label">Название</label>
                <input type="text" name="name" class="form-control" id="name" />
                <button class="btn btn-primary">Сохранить</button>
            </form>
        </div>
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Номер категории</th>
                <th>Название</th>
            </tr>
        </thead>
        <tbody>
            @foreach (CategoryViewModel category in Model)
            {
                <tr>
                    <td>@category.Id</td>
                    <td>@category.Name</td>
                    <td>
                        <a href="/Category/Parameters/@category.Id">Редактировать</a>
                        <a href="/Category/Delete/@category.Id">Удалить</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
