@model List<News>
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-left">
    <h1 class="display-4">Сайт с новостями</h1>

    <a href="/Home/Parameters" class="btn btn-primary">Создать новость</a><br />

    <button class="btn btn-primary" type="button" data-toggle="collapse" data-target="#variantSearch" aria-expanded="false" aria-controls="variantSearch">
        Поиск новостей
    </button><br />
    <div class="collapse" id="variantSearch">
        <div class="card card-body">
            <form method="post">
                <label for="name" class="form-label">Название</label>
                <input type="text" name="name" class="form-control" id="name" />
                <label for="category" class="form-label">Категория</label>
                <input type="text" name="category" class="form-control" id="category" />
                <label for="num1" class="form-label">Содержимое</label>
                <input type="text" name="content" class="form-control" id="content" />
                <button class="btn btn-primary">Сохранить</button>
            </form>
        </div>
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Номер новости</th>
                <th>Название</th>
                <th>Категория</th>
                <th>Содержимое</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (News news in Model)
            {
            <tr>
                <td>@news.Id</td>
                <td>@news.Name</td>
                <td>@news.Category</td>
                <td>@news.Content</td>
                <td>
                    <a href="/home/parameters/@news.Id">Редактировать</a>
                    <a href="/Home/Delete/@news.Id">Удалить</a>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>
