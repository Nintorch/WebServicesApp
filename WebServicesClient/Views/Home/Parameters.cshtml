@model NewsModifyViewModel
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-left">

    <form method="post">
        <input type="hidden" name="id" value="@Model?.News?.Id" />
        <label for="name" class="form-label">Название</label>
        <input type="text" name="name" class="form-control" id="name" value="@Model?.News?.Name">

        <label for="categoryId" class="form-label">Категория</label>
        <select name="categoryId" class="custom-select">
            <option value="0">(Без категории)</option>
            @foreach (CategoryViewModel category in Model?.Categories)
            {
                if (Model?.News != null && Model.News.CategoryId == category.Id)
                {
                    <option value="@category.Id" selected>@category.Name</option>
                }
                else
                {
                    <option value="@category.Id">@category.Name</option>
                }
            }
        </select>

        <label for="num1" class="form-label">Содержимое</label>
        <input type="text" name="content" class="form-control" id="content" value="@Model?.News?.Content" />
        <button class="btn btn-primary">Сохранить</button>
    </form>
</div>
