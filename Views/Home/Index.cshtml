@model List<Variant>
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-left">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://docs.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>

    <a href="/Home/Parameters" class="btn btn-primary">Создать вариант</a><br />

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Номер варианта</th>
                <th>Название</th>
                <th>Число 1</th>
                <th>Число 2</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                @foreach (Variant variant in Model)
                {
                    <td>@variant.Id</td>
                    <td>@variant.Name</td>
                    <td>@variant.Number1</td>
                    <td>@variant.Number2</td>
                    <td>
                        <a href="/home/parameters/@variant.Id">Редактировать</a>
                        <a href="/Home/Delete/@variant.Id">Удалить</a>
                    </td>
                }
            </tr>
        </tbody>
    </table>
</div>
